<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Full access to Demo Scorecard components including Policy object, fields, Apex classes, and Visualforce pages</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Demo Scorecard Access</label>

    <!-- Apex Class Access -->
    <classAccesses>
        <apexClass>DemoPDFGenerator</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DemoScorecardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DemoScorecardMetrics</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Visualforce Page Access -->
    <pageAccesses>
        <apexPage>DemoScorecardPDF</apexPage>
        <enabled>true</enabled>
    </pageAccesses>

    <!-- Policy Object Access -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Policy__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Policy Field Permissions -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Policy__c.Account__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Policy__c.Broker__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Policy__c.Coverage_Type__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Policy__c.Effective_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Policy__c.Expiration_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Policy__c.Premium__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Policy__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
